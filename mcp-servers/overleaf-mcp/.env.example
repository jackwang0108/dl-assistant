# All optional — defaults are shown. Uncomment to override.

# Overleaf base URL. Change this if you self-host (not the focus of this MCP).
# OVERLEAF_BASE_URL=https://www.overleaf.com

# Root directory for managed Overleaf workspaces.
# Contains credentials.json, projects/<project_id>/repo, and artifacts.
# OVERLEAF_MCP_HOME=~/.local/share/overleaf-mcp

# Where the session cookie + CSRF token are persisted (survives MCP restarts).
# Default is $OVERLEAF_MCP_HOME/credentials.json (0600).
# OVERLEAF_CREDENTIALS_PATH=/abs/path/credentials.json

# Per-request timeout (seconds) for the compile POST — cold compiles of large
# docs can be slow. Other requests use a fixed 60s timeout.
# OVERLEAF_COMPILE_TIMEOUT=180
